# Copy to .env, replace every placeholder, and keep the real file out of Git.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=store.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://store.example.invalid
DJANGO_TRUST_PROXY_HEADERS=true
# Enable HSTS only after HTTPS works for every required hostname/subdomain.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_USE_MANIFEST_STATICFILES=true
DJANGO_CACHE_KEY_PREFIX=secure-commerce
PUBLIC_API_CACHE_SECONDS=60

POSTGRES_DB=secure_commerce
POSTGRES_USER=secure_commerce
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Use a URL-safe password (A-Z, a-z, 0-9, _, -), or percent-encode it in REDIS_URL.
REDIS_PASSWORD=replace-with-a-url-safe-random-password
REDIS_URL=redis://:replace-with-a-url-safe-random-password@redis:6379/0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.invalid
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-smtp-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=orders@store.example.invalid

# Generate a stable Fernet key before enabling MFA in production.
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key
JWT_SIGNING_KEY=replace-with-a-separate-jwt-signing-key
CHECKOUT_TAX_RATE=0.00

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
BACKUP_RETENTION_DAYS=14
